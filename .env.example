# =============================================================================
# ESPORTS APPLICATION ENVIRONMENT VARIABLES
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION MODE
# -----------------------------------------------------------------------------
# Set to 'true' to use fallback/demo data instead of external services
# Set to 'false' to use live data from Contentful/Appwrite
NEXT_PUBLIC_FALLBACK_MODE=true

# -----------------------------------------------------------------------------
# CONTENTFUL CMS CONFIGURATION (Recommended)
# -----------------------------------------------------------------------------
# Get these from your Contentful space settings
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=gk83salrhozo
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=tb8HyulKWftPO7KL7FeY5u1JauthKI_fyquKQ8NSImA
CONTENTFUL_PREVIEW_ACCESS_TOKEN=hb7rwiSlTyveNS3UgOLHkRnybu4U33BqR6T6BSUfHjg
CONTENTFUL_MANAGEMENT_TOKEN=your_management_token_here
CONTENTFUL_ENVIRONMENT=master

# -----------------------------------------------------------------------------
# APPWRITE BACKEND CONFIGURATION (Optional)
# -----------------------------------------------------------------------------
# Uncomment and configure if you want to use Appwrite for user authentication
# NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id_here
# NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
# NEXT_PUBLIC_APPWRITE_DB_ID=your_database_id_here
# NEXT_PUBLIC_APPWRITE_PROFILE_COLLECTION_ID=profiles

# -----------------------------------------------------------------------------
# STRAPI CMS CONFIGURATION (Legacy - Not Recommended)
# -----------------------------------------------------------------------------
# These are kept for backward compatibility but Contentful is recommended
# NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
# STRAPI_API_TOKEN=your_strapi_api_token_here

# -----------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION
# -----------------------------------------------------------------------------
# These are set automatically by deployment platforms
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
# NEXTAUTH_URL=https://your-domain.com
# NEXTAUTH_SECRET=your_nextauth_secret_here

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. QUICK START (Demo Mode):
#    - Keep NEXT_PUBLIC_FALLBACK_MODE=true
#    - Run: npm run dev
#    - Everything works with demo data!
#
# 2. CONTENTFUL SETUP (Recommended):
#    - Follow CONTENTFUL_SETUP.md guide
#    - Set NEXT_PUBLIC_FALLBACK_MODE=false
#    - Configure Contentful variables above
#
# 3. APPWRITE SETUP (Optional):
#    - Create Appwrite project
#    - Configure Appwrite variables above
#    - Set NEXT_PUBLIC_FALLBACK_MODE=false
#
# =============================================================================