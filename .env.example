# Example environment variables
# Copy this file to .env and fill in your actual values

# Strapi Backend URL
NEXT_PUBLIC_STRAPI_URL=https://your-strapi-backend.up.railway.app

# Frontend Base URL
NEXT_PUBLIC_BASE_URL=https://your-frontend-domain.com

# Environment
NODE_ENV=production

# Strapi API Token (if needed)
NEXT_PUBLIC_STRAPI_API_TOKEN=your_api_token_here
STRAPI_API_TOKEN=your_api_token_here

# Encryption Key (if needed)
ENCRYPTION_KEY=your_encryption_key_here