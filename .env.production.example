# =============================================================================
# KVE (Kenya Varsity Esports) - PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# This file is a REFERENCE ONLY - it is not loaded automatically by Next.js.
#
# How to use:
#   - Vercel: Project -> Settings -> Environment Variables (scope: Production)
#   - Self-hosted/Docker: create .env.production on the server (never commit it)
#
# Copy each value below into your hosting provider's environment settings.
# Replace all <...> placeholders. NEVER commit real secret values.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION MODE
# -----------------------------------------------------------------------------
# Must be 'false' in production (true enables demo data / demo admin user)
NEXT_PUBLIC_FALLBACK_MODE=false

# -----------------------------------------------------------------------------
# PUBLIC APP URL (HTTPS, no trailing slash)
# Used for payment redirects and the logo in ticket emails
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://www.kve.co.ke

# -----------------------------------------------------------------------------
# APPWRITE BACKEND
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_PROJECT_ID=68c7e7bc0028f9acee36
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_DB_ID=68c7f25e00083a6d2992
NEXT_PUBLIC_APPWRITE_RANKINGS_COLLECTION_ID=rankings
NEXT_PUBLIC_APPWRITE_REGIONS_COLLECTION_ID=regions
NEXT_PUBLIC_APPWRITE_REGIONAL_RANKINGS_COLLECTION_ID=regional_rankings
NEXT_PUBLIC_APPWRITE_GAME_CATEGORIES_COLLECTION_ID=game-categories
NEXT_PUBLIC_APPWRITE_UNIVERSITIES_COLLECTION_ID=universities
NEXT_PUBLIC_APPWRITE_SPONSORS_COLLECTION_ID=sponsors
NEXT_PUBLIC_APPWRITE_CONTACT_MESSAGES_COLLECTION_ID=contact-messages
NEXT_PUBLIC_APPWRITE_PROFILE_COLLECTION_ID=user_profiles
NEXT_PUBLIC_APPWRITE_TOURNAMENTS_COLLECTION_ID=tournaments
NEXT_PUBLIC_APPWRITE_TOURNAMENT_REGISTRATIONS_COLLECTION_ID=tournament_registrations
NEXT_PUBLIC_APPWRITE_AWARDS_COLLECTION_ID=tournament_awards
NEXT_PUBLIC_APPWRITE_EVENTS_COLLECTION_ID=6965fefb003d0e6ebc13
NEXT_PUBLIC_APPWRITE_BLOG_POSTS_COLLECTION_ID=6accbfbc0036dfe6f9f1

# Server-side Appwrite API key (admin operations: ticket verification, webhooks).
# Recommended: create a dedicated production key limited to the scopes the app
# needs (databases read/write) instead of reusing the development key.
APPWRITE_API_KEY=<server API key from Appwrite Console>

# -----------------------------------------------------------------------------
# TICKET EMAILS (optional - disabled by default)
# -----------------------------------------------------------------------------
# Buyers download their PDF e-tickets from the success/ticket pages.
# Ticket confirmation emails are OFF unless TICKET_EMAIL_ENABLED=true.
# Before enabling, confirm the SMTP credentials below pass this check:
#   node --env-file=.env.production scripts/test-smtp.js
TICKET_EMAIL_ENABLED=false

# -----------------------------------------------------------------------------
# SMTP (only used when TICKET_EMAIL_ENABLED=true)
# -----------------------------------------------------------------------------
# Note: the current events@tunzaesports.com password is rejected by the mail
# server (535 Incorrect authentication data) - the mailbox password must be
# corrected before re-enabling emails.
SMTP_EMAIL=<sender email address>
SMTP_PASSWORD=<smtp password>
SMTP_FROM_EMAIL=<sender email address>
SMTP_HOST=sbg106.truehost.cloud
SMTP_PORT=465

# -----------------------------------------------------------------------------
# MAILCHIMP (newsletter, if used in production)
# -----------------------------------------------------------------------------
MAILCHIMP_API_KEY=<mailchimp api key>
MAILCHIMP_SERVER_PREFIX=us18
MAILCHIMP_AUDIENCE_ID=f341a25b8f

# -----------------------------------------------------------------------------
# PAYSTACK - LIVE MODE
# -----------------------------------------------------------------------------
# Live keys from Paystack Dashboard -> Settings -> API Keys & Webhooks
# (switch the dashboard to Live mode before copying).
PAYSTACK_SECRET_KEY=sk_live_<your live secret key>
PAYSTACK_PUBLIC_KEY=pk_live_<your live public key>

# Fallback callback URL - the app sends its own per-transaction callback
# (…/events/<eventId>/tickets/success?purchaseId=…) which takes precedence.
PAYSTACK_CALLBACK_URL=https://www.kve.co.ke/events

# Must be 'false' in production so the app reports live mode.
PAYSTACK_TEST_MODE=false

# -----------------------------------------------------------------------------
# PAYSTACK DASHBOARD - LIVE MODE SETTINGS (not env vars - set in dashboard)
# -----------------------------------------------------------------------------
# Webhook URL (Live mode): https://www.kve.co.ke/api/payments/webhook?provider=paystack
# The ?provider=paystack query parameter is REQUIRED.
#
# Leave the dashboard's TEST-mode webhook pointing at your local tunnel URL
# while testing locally, and use the URL above for Live mode only.

# -----------------------------------------------------------------------------
# OPTIONAL PROVIDERS (leave unset if not used - providers auto-disable)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TEST_MODE=false
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_ENVIRONMENT=production
# MPESA_CALLBACK_URL=
