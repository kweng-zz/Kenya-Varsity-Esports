# Render Environment Variables
NEXT_PUBLIC_STRAPI_URL=https://kuer-strapi.onrender.com
STRAPI_API_TOKEN=your_render_strapi_token_here
NEXT_PUBLIC_BASE_URL=https://kuer.onrender.com

# Database (will be provided by Render)
DATABASE_URL=postgresql://username:password@host:port/database

# Strapi Secrets (will be auto-generated by Render)
STRAPI_ADMIN_JWT_SECRET=auto_generated
STRAPI_API_TOKEN_SALT=auto_generated
STRAPI_JWT_SECRET=auto_generated
STRAPI_TRANSFER_TOKEN_SALT=auto_generated

# Other configs
NODE_ENV=production
SKIP_STRAPI_BUILD=false