9:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"SEASON 3 REGISTRATION NOW OPEN\",\"description\":\"Universities across Kenya can now register for the upcoming Season 3 of the Kenya University Esports Rankings.\",\"image\":[\"/images/Join-the-Discord.png\"],\"datePublished\":\"2024-01-20T00:00:00.000Z\",\"dateModified\":\"2024-01-20T00:00:00.000Z\",\"author\":{\"@type\":\"Person\",\"name\":\"KUER Team\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"KUER\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://kuer.com/logo.png\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://kuer.com/blogs/season-3-registration-open\"},\"articleSection\":\"Registration\",\"keywords\":\"Registration, Multiple Games, Registration, Season 3, Universities, Competition\"}"}}],["$","main",null,{"className":"bg-black w-full min-h-screen","children":[["$","div",null,{"className":"w-full relative z-20","children":["$","$L6",null,{}]}],["$","$L14",null,{"post":{"id":"4","title":"SEASON 3 REGISTRATION NOW OPEN","description":"Universities across Kenya can now register for the upcoming Season 3 of the Kenya University Esports Rankings.","content":"The registration for KUER Season 3 is now officially open! Universities across Kenya are invited to participate in what promises to be the most exciting season yet.\n\nSeason 3 will feature expanded game titles, increased prize pools, and enhanced streaming coverage. We're expecting record participation as more universities recognize the value of competitive esports.\n\nRegistration is simple and can be completed through our official website. Don't miss this opportunity to showcase your university's gaming talent and compete for the championship title.","slug":"season-3-registration-open","publishedAt":"2024-01-20T00:00:00.000Z","createdAt":"2024-01-20T00:00:00.000Z","updatedAt":"2024-01-20T00:00:00.000Z","featured"