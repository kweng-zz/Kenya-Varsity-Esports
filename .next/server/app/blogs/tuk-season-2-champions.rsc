9:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"TUK TAKES THE OVERALL POSITION FOR SEASON 2\",\"description\":\"The Technical University of Kenya gathers the top position in KUER Season 2, showcasing exceptional gaming skills and teamwork.\",\"image\":[\"/images/Join-Your-Uni.png\"],\"datePublished\":\"2024-01-10T00:00:00.000Z\",\"dateModified\":\"2024-01-10T00:00:00.000Z\",\"author\":{\"@type\":\"Person\",\"name\":\"KUER Team\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"KUER\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://kuer.com/logo.png\"}},\"mainEntityOfPage\":{\"@type\":\"WebPage\",\"@id\":\"https://kuer.com/blogs/tuk-season-2-champions\"},\"articleSection\":\"Championship\",\"keywords\":\"Championship, Call of Duty Mobile, TUK, Championship, Season 2, Victory\"}"}}],["$","main",null,{"className":"bg-black w-full min-h-screen","children":[["$","div",null,{"className":"w-full relative z-20","children":["$","$L6",null,{}]}],["$","$L14",null,{"post":{"id":"3","title":"TUK TAKES THE OVERALL POSITION FOR SEASON 2","description":"The Technical University of Kenya gathers the top position in KUER Season 2, showcasing exceptional gaming skills and teamwork.","content":"The Technical University of Kenya (TUK) has claimed the overall championship position in KUER Season 2, demonstrating exceptional gaming skills and remarkable teamwork throughout the competition.\n\nTUK's path to victory was characterized by consistent performance across multiple game titles and strategic gameplay that outmaneuvered their competitors. The team's dedication to practice and their ability to adapt to different gaming scenarios proved to be the key factors in their success.\n\nThis championship win solidifies TUK's position as one of the premier esports institutions in Kenya and sets a high standard for future competitions. Their victory serves as motivation for other universities to strengthen their esports programs and compete at the highest level.","slug":"tuk-season-2-champions","publishedAt":"2024-01-10T00:00:00.000Z","createdAt":"2024-01-10T00:00:00.000Z","updatedAt":"2024-01-10T00:00:00.000Z","featured":false,"category":"Championship","game":"Call of Duty Mobile","author":"KUER Team","tags":["TUK","Championship","Season 2","Victory"],"imageUrl":"/images/Join-Your-Uni.png","image":null}}],["$","$L8",null,{}]]}]]
