11:["$","li","point-1-13",{"className":"text-[26px]","children":"• Analyze website usage (via cookies)"}]
12:["$","li","point-1-14",{"className":"text-[26px]","children":"• In instances such students verification process your students IDs and any other document needed during process will be deleted after verification."}]
13:["$","li","point-1-15",{"className":"text-[26px]","children":""}]
14:["$","li","point-1-16",{"className":"text-[26px]","children":"2.3 Legal Basis for Processing"}]
15:["$","li","point-1-17",{"className":"text-[26px]","children":"Your data is processed under the lawful bases of:"}]
16:["$","li","point-1-18",{"className":"text-[26px]","children":"• Consent – e.g., for marketing or cookies"}]
17:["$","li","point-1-19",{"className":"text-[26px]","children":"• Contract – e.g., when signing up for a service"}]
18:["$","li","point-1-20",{"className":"text-[26px]","children":"• Legal Obligation – e.g., to retain records"}]
19:["$","li","point-1-21",{"className":"text-[26px]","children":"• Legitimate Interests – e.g., internal analysis"}]
