7:["$","li","point-1-3",{"className":"text-[26px]","children":"2.2 Purpose of Data Collection"}]
8:["$","li","point-1-4",{"className":"text-[26px]","children":"We collect personal data when:"}]
9:["$","li","point-1-5",{"className":"text-[26px]","children":"• You submit contact or registration forms"}]
a:["$","li","point-1-6",{"className":"text-[26px]","children":"• You participate in our competitions or services"}]
