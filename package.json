    "test:appwrite": "node scripts/test-appwrite-connection.js",
    "configure:appwrite-cors": "node scripts/configure-appwrite-cors-rest.js",
    "diagnose:appwrite-cors": "node scripts/diagnose-appwrite-cors.js",
    "cors:status": "node scripts/appwrite-cors-status.js",
