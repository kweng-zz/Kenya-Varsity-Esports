{
  "name": "kuer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Strapi application with Next.js frontend",
  "scripts": {
    "dev": "concurrently --names \"STRAPI,NEXT\" --prefix-colors \"blue,green\" \"npm run strapi:dev\" \"npm run dev:next\"",
    "dev:simple": "node start.js",
    "dev:next": "next dev --turbopack",
    "dev:strapi": "npm run strapi:dev",
    "build": "next build",
    "build:next": "next build",
    "build:local": "npm run strapi:build && next build",
    "build:vercel": "SKIP_STRAPI_BUILD=true next build",
    "build:with-strapi": "npm run strapi:build && next build",
    "start": "next start",
    "start:full": "concurrently --names \"STRAPI,NEXT\" --prefix-colors \"blue,green\" \"npm run strapi:start\" \"npm run start:next\"",
    "start:production": "node start-production.js",
    "start:standalone": "node start-standalone.js",
    "start:railway": "node start-railway.js",
    "start:next": "next start",
    "start:strapi": "npm run strapi:start",
    "strapi:dev": "cd kuer && npm run develop",
    "strapi:build": "cd kuer && npm run build",
    "strapi:start": "cd kuer && npm run start",
    "strapi:console": "cd kuer && npm run console",
    "console": "strapi console",
    "deploy": "strapi deploy",
    "develop": "strapi develop",
    "strapi": "strapi",
    "upgrade": "npx @strapi/upgrade latest",
    "upgrade:dry": "npx @strapi/upgrade latest --dry",
    "lint": "eslint",
    "setup:video-highlights": "node scripts/setup-video-highlights-collection.cjs",
    "reset:video-highlights": "node scripts/reset-video-highlights-collection.cjs",
    "setup:appwrite": "node scripts/setup-appwrite-database.js",
    "setup:tournaments": "node scripts/setup-tournaments-fixed.cjs",
    "setup:participants": "node scripts/setup-participants-collection.js",
    "populate:participants": "node scripts/populate-participants.js",
    "setup:tickets": "node scripts/setup-ticket-collections.js",
    "setup:strapi-deploy": "node scripts/setup-strapi-deployment.js",
    "setup:railway": "node railway-deploy.js",
    "verify:railway": "node verify-railway.js",
    "health-check": "node health-check.js",
    "deploy:render": "node scripts/deploy-render.js",
    "switch-env": "node scripts/switch-env.js",
    "build:frontend": "next build",
    "dev:frontend": "next dev",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint --fix ."
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@strapi/plugin-cloud": "5.23.4",
    "@strapi/plugin-users-permissions": "5.23.4",
    "@strapi/strapi": "5.23.4",
    "appwrite": "^20.0.0",
    "better-sqlite3": "11.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "lucide-react": "^0.544.0",
    "next": "15.5.3",
    "node-appwrite": "^19.0.0",
    "pg": "^8.11.3",
    "react": "^18.0.0",
    "react-datepicker": "^8.7.0",
    "react-dom": "^18.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.0.0",
    "react-social-icons": "^6.25.0",
    "styled-components": "^6.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=18.0.0 <=22.x.x",
    "npm": ">=6.0.0"
  },
  "strapi": {
    "uuid": "35cef7d8-80ea-441a-968a-f718d18f22f6",
    "installId": "2cf0082c3ac7129521c16e64f6c8487c875bda70c8ca149225d4ea562cdbbe13"
  }
