{
  "name": "kuer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "University Esports Platform - Next.js Application",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=4096' next dev --webpack",
    "build": "next build",
    "build:analyze": "cross-env ANALYZE=true next build --webpack",
    "analyze": "cross-env ANALYZE=true next build --webpack && start bundle-analyzer-report.html",
