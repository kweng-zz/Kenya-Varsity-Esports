{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "kuer/api/index.js",
      "use": "@vercel/node",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/strapi/(.*)",
      "dest": "/kuer/api/index.js"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/kuer/api/index.js"
    },
    {
      "src": "/api/strapi/(.*)",
      "dest": "/kuer/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "functions": {
    "kuer/api/index.js": {
      "maxDuration": 30
    },
    "app/**/*.{js,ts,tsx}": {
      "maxDuration": 30
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}